# FitTrack — environment variables
# Copy this file to .env and fill in the values before starting.

# Required: username for the admin account (created on first start).
ADMIN_USERNAME=

# Required: password for the admin account. Recommend ≥16 random chars.
ADMIN_PASSWORD=

# Required: secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Never share or commit this value.
APP_SECRET=

# Optional: path to the SQLite database file (default: /data/fitness.db)
# DATABASE_PATH=/data/fitness.db

# Optional: how many days a login session lasts (default: 30, range: 1–365)
# SESSION_DAYS=30

# Optional: URL to POST webhook events to (pr_achieved, session_complete)
# WEBHOOK_URL=

# Optional: AI Coach (local Ollama LLM that builds routines from your history).
# Ollama runs on-device; no data leaves the host. Install from https://ollama.com,
# then: `ollama pull qwen2.5:3b`
# OLLAMA_URL=http://localhost:11434        # in Docker use http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b                   # any installed model; gemma3:1b is faster/lighter
