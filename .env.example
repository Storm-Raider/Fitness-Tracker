# FitTrack — environment variables
# Copy this file to .env and fill in the values before starting.

# Required: username for the admin account (created on first start).
ADMIN_USERNAME=

# Required: password for the admin account. Recommend ≥16 random chars.
ADMIN_PASSWORD=

# Required: secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Never share or commit this value.
APP_SECRET=

# Optional: path to the SQLite database file (default: /data/fitness.db)
# DATABASE_PATH=/data/fitness.db

# Optional: encrypt the database at rest with SQLCipher.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then run the one-time migration: DB_ENCRYPTION_KEY=<key> python scripts/encrypt_db.py
# Prerequisites: pip install sqlcipher3
# DB_ENCRYPTION_KEY=

# Optional: how many days a login session lasts (default: 30, range: 1–365)
# SESSION_DAYS=30

# Optional: URL to POST webhook events to (pr_achieved, session_complete)
# WEBHOOK_URL=

# Optional: enable the in-app Feedback form to file bug reports / feature
# requests straight to GitHub Issues. Needs a personal access token with
# `repo` (private) or `public_repo` (public) scope. Without GITHUB_TOKEN the
# Feedback page shows a "not configured" notice and links to GitHub directly.
# GITHUB_TOKEN=
# GITHUB_REPO=Storm-Raider/Fitness-Tracker

# Optional: AI Coach (Google Gemini builds routines from your history).
# Get a key at https://aistudio.google.com/apikey. Without it the Coach is
# disabled. NOTE: the prompt (training history, set notes, journal wellness,
# injury flags) is sent to Google; on the free tier Google may use it to improve
# its products — the paid tier does not.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash             # default; any Gemini model id that supports JSON schema output
# COACH_MAX_QUEUE=5                          # max coach requests queued+running before new ones get a busy 429 (generations run one at a time)
