# FitTrack — environment variables
# Copy this file to .env and fill in the values before starting.

# Required: username for the admin account (created on first start).
ADMIN_USERNAME=

# Required: password for the admin account. Recommend ≥16 random chars.
ADMIN_PASSWORD=

# Required: secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Never share or commit this value.
APP_SECRET=

# Optional: path to the SQLite database file (default: /data/fitness.db)
# DATABASE_PATH=/data/fitness.db

# Optional: encrypt the database at rest with SQLCipher.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then run the one-time migration: DB_ENCRYPTION_KEY=<key> python scripts/encrypt_db.py
# Prerequisites: pip install sqlcipher3
# DB_ENCRYPTION_KEY=

# Optional: how many days a login session lasts (default: 30, range: 1–365)
# SESSION_DAYS=30

# Optional: URL to POST webhook events to (pr_achieved, session_complete)
# WEBHOOK_URL=

# Optional: enable the in-app Feedback form to file bug reports / feature
# requests straight to GitHub Issues. Needs a personal access token with
# `repo` (private) or `public_repo` (public) scope. Without GITHUB_TOKEN the
# Feedback page shows a "not configured" notice and links to GitHub directly.
# GITHUB_TOKEN=
# GITHUB_REPO=Storm-Raider/Fitness-Tracker

# Optional: AI Coach (Ollama LLM that builds routines from your history).
# Everything stays on your LAN — no data leaves the host/network. Install from
# https://ollama.com, then: `ollama pull qwen2.5:1.5b`
# OLLAMA_URL=http://localhost:11434        # in Docker use http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:1.5b               # recommended: ~2x faster than 3b, same JSON quality
#                                          # alternatives: qwen2.5:3b (slower), gemma3:1b (fastest, lower quality)
#                                          # or point at a bigger model on a beefier networked
#                                          # machine, e.g. OLLAMA_URL=http://192.168.1.x:11434,
#                                          # OLLAMA_MODEL=qwen3:8b — better output, but now the
#                                          # coach depends on that machine being up.

# Optional: fallback when the primary OLLAMA_URL/OLLAMA_MODEL above is
# unreachable (down, timed out, or the model isn't pulled there) — the coach
# retries once against this before failing the request. Defaults to this same
# machine's own local Ollama, which is why running a networked primary is
# safe: worst case, generation degrades to the local model instead of
# failing outright. Only worth setting explicitly if you want the fallback to
# be something other than local qwen2.5:1.5b.
# OLLAMA_FALLBACK_URL=http://localhost:11434
# OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
# COACH_MAX_QUEUE=5                          # max coach requests queued+running before new ones get a busy 429 (the Pi always runs one at a time)
