# Secrets — never commit
.env
GH-Token
*-token
*.token

# gstack internal artifacts (AI design audit, QA reports, screenshots)
.gstack/
screenshots-audit/

# Playwright screenshot diffs / actuals (baselines are tracked)
tests/snapshots/actual/

# Live database and WAL files
/data/
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
FitStorm-Icon.png
cron/fitstorm-enrich

# Runtime logs (keep the dir via logs/.gitkeep, ignore the log files)
logs/*.log

# Auto-deploy marker: the commit the running server booted on (runtime state)
logs/deployed-commit

# gstack graphify output (local AI artifact cache)
graphify-out/
